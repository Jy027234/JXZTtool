# Production RAG profile: Alibaba Qwen text embeddings plus second-stage rerank.
#
# The model-router protocol was live-checked on 2026-07-15:
# - qwen/text-embedding-v4 returns 1024-dimensional vectors;
# - qwen/qwen3-vl-rerank accepts input.query/input.documents at /v1/rerank.
#
# Replace the database URL through deployment configuration.  Inject the shared
# gateway credential only through PARSECORE_ALIYUN_API_KEY; never put it here.
# A pre-existing pgvector schema with another vector dimension needs an explicit
# migration or a fresh schema before this profile is enabled.

[project]
name = "parsecore-starter"
mode = "embedded-sdk"

[runtime]
execution_mode = "queue-worker"
max_workers = 2
max_inflight_jobs = 0
max_active_parts_per_doc = 0
max_upload_bytes = 52428800
staged_upload_max_bytes = 0
allow_external_file_paths = false
quota_enforce = false
quota_window_hours = 24
quota_default_limit_units = 0
max_attempts = 3
retry_backoff_seconds = 1.0
retry_backoff_max_seconds = 60.0
poll_interval_ms = 500
log_path = "var/logs/job_events.jsonl"

[storage]
# Replace credentials and host through the deployment secret/config system.
database_url = "postgresql://parsecore:parsecore@parsecore-postgres:5432/parsecore"
object_store = "local://./var/uploads"

[index]
mode = "pgvector"
embedding_dimension = 1024

[translation]
enabled = true
strategy = "lazy"

[product]
adapter = "embedded"

[providers.embedding]
enabled = true
provider = "openai-compatible"
model = "qwen/text-embedding-v4"
base_url = "https://model-router.edu-aliyun.com/v1"
api_key_env = "PARSECORE_ALIYUN_API_KEY"
timeout_seconds = 30.0
max_retries = 2
# The selected gateway rejected 16-input requests with HTTP 400 during the
# representative PDF-slice acceptance. Five inputs per request is live-verified.
batch_size = 5

[providers.rerank]
enabled = true
provider = "dashscope-compatible"
model = "qwen/qwen3-vl-rerank"
base_url = "https://model-router.edu-aliyun.com/v1"
api_key_env = "PARSECORE_ALIYUN_API_KEY"
timeout_seconds = 30.0
max_retries = 2
# The existing hybrid retrieval supplies at most this many candidates to /rerank.
candidate_limit = 30

[providers.ocr]
enabled = true
provider = "rapidocr"

[[parsers]]
name = "docx-native"
media_types = ["application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
extensions = [".docx"]

[[parsers]]
name = "pdf-text"
media_types = ["application/pdf"]
extensions = [".pdf"]

[parsers.options.post_process]
dual_channel = true
dual_table_min_rows = 2
dual_table_min_cols = 2
ocr_bad_pages = true
ocr_bad_page_min_cid_tokens = 5
ocr_bad_page_min_cid_char_ratio = 0.25
ocr_render_resolution = 110
ocr_confidence_threshold = 0.5
ocr_merge_line_gap_ratio = 1.6

[[parsers]]
name = "image-ocr"
media_types = ["image/png", "image/jpeg"]
extensions = [".png", ".jpg", ".jpeg"]

[[parsers]]
name = "excel-native"
media_types = [
    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    "application/vnd.ms-excel.sheet.macroEnabled.12",
    "application/vnd.ms-excel",
]
extensions = [".xlsx", ".xlsm", ".xls"]

[[parsers]]
name = "text-native"
media_types = ["text/plain"]
extensions = [".txt", ".md"]
